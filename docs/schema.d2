# ============================================================================
# Expert Hub - database entity-relationship diagram (D2)
#
# GENERATED FILE - regenerate it, never hand-edit it. Hand edits are lost the
# next time the schema moves.
#
# Source of truth : backend/src/ExpertHub.Infrastructure/Migrations/
#                   ExpertHubDbContextModelSnapshot.cs  (the applied schema),
#                   cross-checked against
#                   .../Persistence/Configurations/*.cs  (Fluent API, indexes,
#                   delete behaviour) and .../Persistence/ExpertHubDbContext.cs
#                   (DbSets and the CAP-xx capability grouping).
# DbContext       : ExpertHubDbContext (the only one in the solution)
# Generated       : 2026-10-01
#
# Render:
#   d2 --layout=elk docs/schema.d2 docs/schema.svg
#
# Conventions
# -----------
# * Table and column names are the REAL database names (SCREAMING_SNAKE_CASE
#   tables, snake_case columns), not the C# property names.
# * Columns shown are key-only: every primary key, every foreign key, and one
#   or two columns that identify the row (a code, a reference, a status).
#   Payload columns, timestamps and bilingual label pairs are omitted.
# * `NULL` in a column's type means the column is nullable; no marker means
#   NOT NULL.
# * Index rows: `UQ (...)` is a unique index or unique constraint, `IX (...)`
#   a plain index. The single-column index EF creates for each foreign key is
#   implied by `constraint: foreign_key` and is not repeated as a row.
# * Edges run dependent -> principal and are labelled with the cardinality,
#   the foreign-key COLUMN, and the delete behaviour. The snapshot carries no
#   HasConstraintName anywhere in the model, so no database constraint name
#   exists to quote; EF derives them (FK_<table>_<principal>_<column>).
# * A dashed edge is an optional relationship (nullable foreign key).
# * `1:1` is a relationship the snapshot pins down with WithOne, a shared
#   primary key, or a unique index over the whole foreign key.
# * Enums are not drawn (every status/code column is persisted as nvarchar);
#   there are no owned types, no implicit many-to-many join tables and no
#   HasPrincipalKey in this model. ROLE_PERMISSION and DASHBOARD_METRIC are
#   explicit join tables with composite primary keys (dashed border).
# * EXT_ERP_PURCHASE_ORDER and FAST_USER_PROFILE are replicas of data another
#   system masters (dotted border): ERP and FAST respectively.
# * Hidden on purpose (technical / append-only audit tables):
#     - AUDIT_LOG - CAP-08 append-only audit trail
#     - DOCUMENT_BLOB - attachment bytes (document store)
#     - INTEGRATION_LOG - CAP-12 append-only crossing log
#     - NOTIFICATION_LOG - CAP-07 append-only send log
#     - OUTBOX_MESSAGE - CAP-12 transactional outbox
#     - SESSION_TICKET - server-side auth ticket store
#   __EFMigrationsHistory is EF's own bookkeeping and is not part of the model.
# ============================================================================

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  join_table: {
    style.stroke-dash: 4
  }
  external: {
    style.stroke-dash: 2
  }
}

shared: "Shared foundation - attachments and reference data" {
  ATTACHMENT: {
    shape: sql_table
    attachment_id: "uniqueidentifier" {constraint: primary_key}
    uploaded_by: "uniqueidentifier" {constraint: foreign_key}
    file_name: "nvarchar(255)"
    scan_status: "nvarchar(30) NULL"
  }
  REFERENCE_LIST: {
    shape: sql_table
    list_code: "nvarchar(50)" {constraint: primary_key}
    name_en: "nvarchar(200)"
    is_editable: "bit"
  }
  REFERENCE_VALUE: {
    shape: sql_table
    value_id: "uniqueidentifier" {constraint: primary_key}
    list_code: "nvarchar(50)" {constraint: foreign_key}
    code: "nvarchar(64)"
    is_active: "bit"
    "UQ (list_code, code)": index
  }
}

cap08: "CAP-08 - identity, access and the FAST profile replica" {
  APP_USER: {
    shape: sql_table
    user_id: "uniqueidentifier" {constraint: primary_key}
    external_identity_id: "nvarchar(200)" {constraint: unique}
    is_active: "bit"
  }
  FAST_USER_PROFILE: {
    shape: sql_table
    class: external
    user_id: "uniqueidentifier" {constraint: primary_key}
    fast_user_id: "nvarchar(64) NULL"
    last_synced_at: "datetime2"
  }
  PERMISSION: {
    shape: sql_table
    permission_id: "int" {constraint: primary_key}
    feature_code: "nvarchar(20)" {constraint: unique}
    capability_code: "nvarchar(10)"
  }
  ROLE: {
    shape: sql_table
    role_id: "int" {constraint: primary_key}
    code: "nvarchar(30)" {constraint: unique}
    is_system: "bit"
  }
  ROLE_PERMISSION: {
    shape: sql_table
    class: join_table
    role_id: "int" {constraint: primary_key}
    permission_id: "int" {constraint: primary_key}
    data_scope: "nvarchar(10)"
  }
  USER_ROLE: {
    shape: sql_table
    user_role_id: "uniqueidentifier" {constraint: primary_key}
    assigned_by: "uniqueidentifier" {constraint: foreign_key}
    role_id: "int" {constraint: foreign_key}
    user_id: "uniqueidentifier" {constraint: foreign_key}
    scope_ref: "uniqueidentifier NULL"
    "UQ (user_id, role_id, scope_ref)": index
  }
}

cap01: "CAP-01 - applications and the form schema" {
  APPLICATION: {
    shape: sql_table
    application_id: "uniqueidentifier" {constraint: primary_key}
    applicant_user_id: "uniqueidentifier" {constraint: foreign_key}
    schema_version: "nvarchar(50)" {constraint: foreign_key}
    reference: "nvarchar(20) NULL" {constraint: unique}
    status: "nvarchar(30)"
  }
  APPLICATION_ATTACHMENT: {
    shape: sql_table
    application_attachment_id: "uniqueidentifier" {constraint: primary_key}
    application_id: "uniqueidentifier" {constraint: foreign_key}
    attachment_id: "uniqueidentifier NULL" {constraint: foreign_key}
    rule_code: "nvarchar(80)"
    file_name: "nvarchar(255)"
  }
  APPLICATION_FIELD_VALUE: {
    shape: sql_table
    value_id: "uniqueidentifier" {constraint: primary_key}
    application_id: "uniqueidentifier" {constraint: foreign_key}
    field_code: "nvarchar(80)"
    entry_index: "int"
    "UQ (application_id, field_code, entry_index)": index
  }
  APPLICATION_SERVICE: {
    shape: sql_table
    application_service_id: "uniqueidentifier" {constraint: primary_key}
    application_id: "uniqueidentifier" {constraint: foreign_key}
    service: "nvarchar(30)"
    outcome: "nvarchar(20)"
    "UQ (application_id, service)": index
  }
  ATTACHMENT_RULE: {
    shape: sql_table
    rule_id: "uniqueidentifier" {constraint: primary_key}
    schema_version: "nvarchar(50)" {constraint: foreign_key}
    rule_code: "nvarchar(80)"
    required_for_services: "nvarchar(200)"
    "UQ (schema_version, rule_code)": index
  }
  FORM_FIELD: {
    shape: sql_table
    field_id: "uniqueidentifier" {constraint: primary_key}
    schema_version: "nvarchar(50)" {constraint: foreign_key}
    field_code: "nvarchar(80)"
    input_type: "nvarchar(20)"
    "UQ (schema_version, field_code)": index
  }
  FORM_SCHEMA: {
    shape: sql_table
    schema_version: "nvarchar(50)" {constraint: primary_key}
    status: "nvarchar(20)"
    published_at: "datetime2 NULL"
  }
  FORM_SECTION: {
    shape: sql_table
    section_id: "uniqueidentifier" {constraint: primary_key}
    schema_version: "nvarchar(50)" {constraint: foreign_key}
    section_code: "nvarchar(50)"
    order_index: "int"
    "UQ (schema_version, section_code)": index
  }
  SERVICE_REQUEST: {
    shape: sql_table
    service_request_id: "uniqueidentifier" {constraint: primary_key}
    application_id: "uniqueidentifier" {constraint: foreign_key}
    decided_by: "uniqueidentifier NULL" {constraint: foreign_key}
    trainer_user_id: "uniqueidentifier" {constraint: foreign_key}
    reference: "nvarchar(24)" {constraint: unique}
    status: "nvarchar(20)"
  }
}

cap02: "CAP-02 - screening, interview and committee" {
