  INTERVIEW_AXIS: {
    shape: sql_table
    axis_id: "uniqueidentifier" {constraint: primary_key}
    interview_model_id: "uniqueidentifier" {constraint: foreign_key}
    axis_code: "nvarchar(50)"
    weight: "decimal(5,1)"
  }
  INTERVIEW_AXIS_SCORE: {
    shape: sql_table
    axis_score_id: "uniqueidentifier" {constraint: primary_key}
    axis_id: "uniqueidentifier" {constraint: foreign_key}
    interview_evaluation_id: "uniqueidentifier" {constraint: foreign_key}
    service: "nvarchar(30)"
    score: "decimal(4,1)"
    "UQ (interview_evaluation_id, axis_id, service)": index
  }
  INTERVIEW_EVALUATION: {
    shape: sql_table
    interview_evaluation_id: "uniqueidentifier" {constraint: primary_key}
    evaluator_user_id: "uniqueidentifier" {constraint: foreign_key}
    interview_id: "uniqueidentifier" {constraint: foreign_key}
    submitted_at: "datetime2 NULL"
    did_not_attend: "bit"
    "UQ (interview_id, evaluator_user_id)": index
  }
  INTERVIEW_MODEL: {
    shape: sql_table
    interview_model_id: "uniqueidentifier" {constraint: primary_key}
    service: "nvarchar(30)"
    version: "nvarchar(50)"
    "UQ (service, version)": index
  }
  INTERVIEW_SLOT: {
    shape: sql_table
    slot_id: "uniqueidentifier" {constraint: primary_key}
    interview_id: "uniqueidentifier" {constraint: foreign_key}
    starts_at: "datetime2"
    is_superseded: "bit"
  }
  SCREENING_CRITERION_SCORE: {
    shape: sql_table
    score_id: "uniqueidentifier" {constraint: primary_key}
    criterion_id: "uniqueidentifier" {constraint: foreign_key}
    screening_result_id: "uniqueidentifier" {constraint: foreign_key}
