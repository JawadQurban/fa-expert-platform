    "IX (request_id, run_at)": index
  }
  MATERIAL_SUBMISSION: {
    shape: sql_table
    submission_id: "uniqueidentifier" {constraint: primary_key}
    engagement_id: "uniqueidentifier" {constraint: foreign_key}
