    row_id: "uniqueidentifier" {constraint: primary_key}
    event_code: "nvarchar(20)" {constraint: foreign_key}
    template_id: "uniqueidentifier" {constraint: foreign_key}
    is_active: "bit"
    audience: "nvarchar(500)"
    "UQ (event_code)": index
  }
  NOTIFICATION_OCCURRENCE: {
    shape: sql_table
    occurrence_id: "uniqueidentifier" {constraint: primary_key}
    event_code: "nvarchar(20)" {constraint: foreign_key}
    dedupe_key: "nvarchar(200) NULL" {constraint: unique}
    routing_status: "nvarchar(20)"
    "IX (raised_at)": index
    "IX (event_code, source_entity_id)": index
  }
  NOTIFICATION_TEMPLATE: {
    shape: sql_table
    template_id: "uniqueidentifier" {constraint: primary_key}
    updated_by: "uniqueidentifier" {constraint: foreign_key}
    code: "nvarchar(100)"
    status: "nvarchar(20)"
  }
  SLA_INSTANCE: {
    shape: sql_table
    instance_id: "uniqueidentifier" {constraint: primary_key}
    sla_id: "nvarchar(20)" {constraint: foreign_key}
    entity_type: "nvarchar(100)"
    state: "nvarchar(20)"
    "IX (entity_type, entity_id)": index
  }
  SLA_MATRIX_ROW: {
    shape: sql_table
    sla_id: "nvarchar(20)" {constraint: primary_key}
    action_code: "nvarchar(100)"
    duration: "int NULL"
  }
}

cap09: "CAP-09 - analytics definitions" {
  DASHBOARD: {
    shape: sql_table
    dashboard_id: "uniqueidentifier" {constraint: primary_key}
    role_id: "int" {constraint: foreign_key}
    feature_code: "nvarchar(16)"
    name_en: "nvarchar(200)"
    "UQ (role_id)": index
  }
  DASHBOARD_METRIC: {
    shape: sql_table
    class: join_table
    dashboard_id: "uniqueidentifier" {constraint: primary_key}
    metric_id: "uniqueidentifier" {constraint: primary_key}
    order_index: "int"
  }
  METRIC_DEFINITION: {
    shape: sql_table
    metric_id: "uniqueidentifier" {constraint: primary_key}
    code: "nvarchar(64)" {constraint: unique}
    source_capability: "nvarchar(10)"
  }
}

cap12: "CAP-12 - integration governance" {
  DATA_ELEMENT: {
    shape: sql_table
    element_id: "uniqueidentifier" {constraint: primary_key}
    system_code: "nvarchar(20)" {constraint: foreign_key}
    element_name: "nvarchar(100)"
    owning_system: "nvarchar(40)"
    "UQ (system_code, element_name)": index
  }
  INTEGRATED_SYSTEM: {
    shape: sql_table
    system_code: "nvarchar(20)" {constraint: primary_key}
    name_en: "nvarchar(200)"
    is_active: "bit"
  }
  REPLICATION_STATE: {
    shape: sql_table
    state_id: "uniqueidentifier" {constraint: primary_key}
    system_code: "nvarchar(20)" {constraint: foreign_key}
    entity_type: "nvarchar(100)"
    drift_status: "nvarchar(20)"
    "UQ (entity_type, local_entity_id, system_code)": index
  }
}

