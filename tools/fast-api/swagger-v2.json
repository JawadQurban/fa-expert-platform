{
  "openapi": "3.0.1",
  "info": {
    "title": "FA API",
    "version": "v2"
  },
  "servers": [
    {
      "url": "/fa-api"
    }
  ],
  "paths": {
    "/api/v2/Catalog/search": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "Keyword",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/CatalogItemType"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language to be used for the response data",
            "required": true,
            "schema": {
              "enum": [
                "ar",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogItemType": {
        "enum": [
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Please enter 'Bearer' [space] and then your token in the text input below.\n\nExample: \"Bearer 12345abcdef\"",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}