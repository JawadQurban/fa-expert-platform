# Expert Hub deployment configuration — EXAMPLE.
# Copy to `.env.expert-hub` (git-ignored) and set per environment.
# ⚠️ Browser-visible frontend values only — NEVER secrets, tokens, DB or service
#    credentials. The frontend knows only the Expert Hub API URL + public auth.

# ── BUILD-TIME (baked into hashed asset URLs; passed as Docker build args) ────
# Base path the app is served under. `/expert-hub` (default) or empty for root.
EXPERT_HUB_BASE_PATH=/expert-hub

# ── RUNTIME (injected into config.js at container START; override per env) ────
# Expert Hub ASP.NET Core API base URL. EMPTY ⇒ in-memory mock (no backend yet).
#   dev:  (empty)        uat: https://uat.example/expert-hub/api   prod: /expert-hub/api
EXPERT_HUB_API_BASE_URL=
# Environment label surfaced in diagnostics: development | uat | production
EXPERT_HUB_ENV=production
# Optional public SSO authorize entry URL (Academy SSO — INT-01, future).
EXPERT_HUB_SSO_ENTRY_URL=
# Optional public telemetry endpoint.
EXPERT_HUB_TELEMETRY_URL=

# ── HOST (docker-compose) ─────────────────────────────────────────────────────
# Host port bound to 127.0.0.1 only; the external server Nginx proxies to it.
EXPERT_HUB_HOST_PORT=8085
# Image tag to build/run (deploy scripts use a versioned tag instead).
EXPERT_HUB_IMAGE_TAG=local
