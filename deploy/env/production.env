# Expert Hub — PRODUCTION runtime configuration.
#
# Rendered into the browser-visible config.js at container start. ⚠️ PUBLIC:
# never add a secret, token, password, or any FAST / MTM / ERP / SQL value here.
# The entrypoint refuses to start if EXPERT_HUB_OIDC_CLIENT_SECRET is set.
#
#   docker compose --env-file deploy/env/production.env up -d

EXPERT_HUB_ENV=production

# Expert Hub API. ⚠️ REQUIRED here: empty ⇒ the app refuses to start with a
# configuration error (demo data is allowed only in development/test).
EXPERT_HUB_API_BASE_URL=
EXPERT_HUB_TELEMETRY_URL=

# ── OpenID Connect — INT-01, the Academy / FAST identity provider ────────────
#
# ⏳ Awaiting the FAST team's client registration. While EXPERT_HUB_OIDC_CLIENT_ID
# is empty the app refuses to start (the development sign-in placeholder is
# allowed only in development/test).
#
# ⚠️ REPLACE THE HOST BELOW with this environment's real origin before sending
# it to FAST — a registered redirect URI must match exactly, and the app
# refuses a non-https URL outside localhost.
#
# WE CHOOSE these two and send them to FAST to register — they must match their
# registration character for character:
EXPERT_HUB_OIDC_REDIRECT_URI=https://REPLACE-WITH-PRODUCTION-HOST/expert-hub/auth/callback
EXPERT_HUB_OIDC_POST_LOGOUT_REDIRECT_URI=https://REPLACE-WITH-PRODUCTION-HOST/expert-hub

# WE ASK for these scopes; FAST grants them. `openid` is required.
EXPERT_HUB_OIDC_SCOPES=openid profile email

# FAST SUPPLIES these:
EXPERT_HUB_OIDC_ISSUER=
EXPERT_HUB_OIDC_DISCOVERY_URL=
EXPERT_HUB_OIDC_CLIENT_ID=

# Claim mapping — names AND values are open (G16/G28), so both live here.
EXPERT_HUB_OIDC_ROLE_CLAIM=
EXPERT_HUB_OIDC_INTERNAL_ROLE_VALUES=
EXPERT_HUB_OIDC_TRAINER_ROLE_VALUES=
EXPERT_HUB_OIDC_NAME_CLAIM=name

# ── The Academy's API (INT-05) ───────────────────────────────────────────────
#
# Read at sign-in, and only then: every endpoint is scoped to «the currently
# authenticated user», and the access token is discarded straight afterwards
# (`P-215`, `P-227`). With this empty the client is OFF — every call fails
# closed with a reason and nothing in the product changes.
#
# What it buys when set: real names in place of usernames (`D-15`), the bank
# form pre-filled from what the Academy already holds, and the person's Academy
# record beside the roles on the access screen.
# ⚠️ Empty until the production API is confirmed.
EXPERT_HUB_FAST_API_BASE_URL=
EXPERT_HUB_FAST_TIMEOUT_SECONDS=30

# Which of the Academy's role values mean "trainer" here (owner ruling,
# 2026-09-08). Someone the Academy already registers as a trainer is granted
# the trainer role at sign-in rather than waiting for an administrator to type
# their name in. Comma-separated, matched case-insensitively against the roles
# on their Academy record.
#
# ⚠️ Requires EXPERT_HUB_FAST_API_BASE_URL — the record is what this reads.
# ⚠️ A role an administrator has revoked is NEVER re-granted from here.
EXPERT_HUB_TRAINER_FAST_ROLES=Trainer
