# Expert Hub — LOCAL TEST SERVER (experts.fa.gov.sa) runtime configuration.
#
# Rendered into the browser-visible config.js at container start. ⚠️ PUBLIC:
# never add a secret, token, password, or any FAST / MTM / ERP / SQL value here.
# The entrypoint refuses to start if EXPERT_HUB_OIDC_CLIENT_SECRET is set.
#
#   docker compose --env-file deploy/env/local.env up -d

EXPERT_HUB_ENV=development

# Expert Hub API. Ends with /api (P-166): auth (/auth/*) and business (/v1/*)
# endpoints both compose against it. Setting it (together with the OIDC client
# below) flips the app to real Academy SSO — P-168.
EXPERT_HUB_API_BASE_URL=https://experts.fa.gov.sa/api
# WHICH MODULES SERVE REAL DATA (owner, 2026-08-31). One module goes live the
# moment its backend ships, so an unbuilt module shows demo data instead of
# failing. Values: 'mock' (nothing live) | 'api' (everything) | 'api:a,b,c'.
#
# Live below: CAP-08 access (BE-03), CAP-07 notifications (BE-05), CAP-01
# applications + add-service (BE-06), CAP-02 screening/interviews/committee
# (BE-07), CAP-03 agreements + lifecycle (BE-08), CAP-04 profile + directory
# + trainer base (BE-09), CAP-05 assignment through engagement (BE-10), and
# `internal` — the staff dashboard and inbox.
#
# ⚠️ `internal` MUST stay live alongside screening/interviews/committee: the
# inbox supplies the application ids those pages open, so a demo inbox in
# front of a live screening page sends it an id the database never had.
#
# With BE-09's `profile` live, the J-09/F6 bank-data save reaches its real
# endpoint, so the WHOLE chain now runs on real data: apply → screen →
# committee → bank data → agreement → an active trainer with a profile.
#
# With BE-11's `entitlements` live, every module that has a backend is on one.
# ⚠️ The entitlement screens will read EMPTY until ERP delivers: `ENTITLEMENT`
# is ERP-mastered and nothing in the platform may author a row (`BR-0601`), so
# the table fills only when INT-03's transport exists (`15` §4) — and `Q39`
# still leaves `BR-0602`'s programme hop unsourced even then. An empty list is
# the honest state, and the portal's own empty text says exactly that.
#
# With BE-12's `home` live, EVERY module in the product is on the real API.
# The only demo path left is the Nafath identity resolver (`G4`) — FAST SSO is
# the live identity path, and Nafath is a separate infrastructure ask.
EXPERT_HUB_DATA_MODE=api:access,notifications,applications,serviceRequests,internal,screening,interviews,committee,agreements,agreementLifecycle,profile,directory,trainerSearch,assignments,engagements,execution,reRouting,submissions,withdrawal,entitlements,home
EXPERT_HUB_TELEMETRY_URL=

# ── OpenID Connect — INT-01, the Academy / FAST identity provider ────────────
#
# ✅ 2026-08-30 — the FAST team shared the TESTING identity details (P-176):
#      authUrl   = https://testingauth.fa.gov.sa/identitymanagement.sts
#      BaseUrl   = https://experts.fa.gov.sa
#      CLIENT_ID = ReactApp
#      REDIRECT_URI (as registered) = https://testingdashboard.fa.gov.sa/callback
#
# ℹ️ PORTAL-FIRST, SILENT (P-178): the registered REDIRECT_URI above is the
#    PORTAL's own callback — users sign in on testingdashboard and are then
#    sent here; Expert Hub completes a silent handshake against the STS
#    session (the login page auto-starts it). ⚠️ That silent leg still needs
#    OUR callback registered with FAST:
#      https://experts.fa.gov.sa/api/auth/callback   (+ localhost for dev)
#    Until then the handshake cannot return to us. Q38.
#
# ⚠️ Two things to confirm about this host before FAST registers it:
#
#   1. HTTPS. This is set to https because virtually every identity provider
#      refuses a non-https redirect URI that is not localhost. If the local
#      server serves plain http, either put a trusted certificate on it or ask
#      FAST whether they will accept http for the test client — do not assume.
#
#   2. BASE PATH — ✅ corrected 2026-08-30 (P-179, supersedes P-164): the
#      testing server serves Expert Hub at https://experts.fa.gov.sa/expert-hub/
#      — the DEFAULT build (VITE_EXPERT_HUB_BASE_PATH=/expert-hub) is exactly
#      right; no build flag needed. The URIs below carry the /expert-hub base.
#
# ⚠️ What FAST registers is the API's callback (P-163), not these:
#      https://experts.fa.gov.sa/api/auth/callback — see 16_SSO §2 and Q38.
# The two values below are the SPA-side config the frontend still reads:
EXPERT_HUB_OIDC_REDIRECT_URI=https://experts.fa.gov.sa/expert-hub/auth/callback
EXPERT_HUB_OIDC_POST_LOGOUT_REDIRECT_URI=https://experts.fa.gov.sa/expert-hub

# WE ASK for these scopes; FAST grants them. `openid` is required.
EXPERT_HUB_OIDC_SCOPES=openid profile email

# ⏸️ PAR temporarily OFF in testing: with the redirect URI still unregistered
# (Q38), the pushed request dies inside our API; the classic redirect sends
# the browser to the STS so FAST sees their own server's response. Remove
# this line (default true) once the registration lands — it is listed on
# `Q38` in the inputs register so closing that ask closes this too.
EXPERT_HUB_OIDC_USE_PAR=false

# ── Platform roles (P-181) ───────────────────────────────────────────────────
# FAST's token carries only the identity (sub + email) — NO role claim. Roles
# live in Expert Hub's own USER_ROLE table, managed on the access screens.
# Bootstrap: the first administrator(s), by user id (the `userId` shown at
# https://experts.fa.gov.sa/api/auth/session after signing in) or by email —
# comma-separated. They receive the system-administrator role at sign-in.
#
# ⚠️ LEAVE THIS EMPTY HERE AND SET IT IN `api.secrets.env` INSTEAD.
# This file is tracked in git, so a value written here is overwritten by the
# next `git pull` — or, worse, blocks the pull with a merge conflict, which
# is exactly what happened on the testing server on 2026-08-31. Compose
# applies `--env-file` in order and the LAST file wins, so a line in the
# untracked `api.secrets.env` overrides this one and survives every pull:
#
#   echo 'EXPERT_HUB_BOOTSTRAP_ADMINS=you@fa.gov.sa' >> env/api.secrets.env
#
# The same goes for anything else that is true of ONE server rather than of
# this environment.
EXPERT_HUB_BOOTSTRAP_ADMINS=

# FAST SUPPLIES these (received 2026-08-30 — the testing identity provider):
EXPERT_HUB_OIDC_ISSUER=https://testingauth.fa.gov.sa/identitymanagement.sts
EXPERT_HUB_OIDC_DISCOVERY_URL=
EXPERT_HUB_OIDC_CLIENT_ID=ReactApp

# Claim mapping — names AND values are open (G16/G28), so both live here.
EXPERT_HUB_OIDC_ROLE_CLAIM=
EXPERT_HUB_OIDC_INTERNAL_ROLE_VALUES=
EXPERT_HUB_OIDC_TRAINER_ROLE_VALUES=
EXPERT_HUB_OIDC_NAME_CLAIM=name

# ── The Academy's API (INT-05) ───────────────────────────────────────────────
#
# Read at sign-in, and only then: every endpoint is scoped to «the currently
# authenticated user», and the access token is discarded straight afterwards
# (`P-215`, `P-227`). With this empty the client is OFF — every call fails
# closed with a reason and nothing in the product changes.
#
# What it buys when set: real names in place of usernames (`D-15`), the bank
# form pre-filled from what the Academy already holds, and the person's Academy
# record beside the roles on the access screen.
# The testing portal, which is what this server points at.
EXPERT_HUB_FAST_API_BASE_URL=https://testingportal.fa.gov.sa/fa-api
EXPERT_HUB_FAST_TIMEOUT_SECONDS=30

# Which of the Academy's role values mean "trainer" here (owner ruling,
# 2026-09-08). Someone the Academy already registers as a trainer is granted
# the trainer role at sign-in rather than waiting for an administrator to type
# their name in. Comma-separated, matched case-insensitively against the roles
# on their Academy record.
#
# ⚠️ Requires EXPERT_HUB_FAST_API_BASE_URL — the record is what this reads.
# ⚠️ A role an administrator has revoked is NEVER re-granted from here.
EXPERT_HUB_TRAINER_FAST_ROLES=Trainer

# INT-06 — Claude for every AI use case until the OpenAI account is funded
# (owner ruling 2026-10-05). The API key goes in api.secrets.env as
# EXPERT_HUB_AI_API_KEY, never here.
EXPERT_HUB_AI_PROVIDER=anthropic
EXPERT_HUB_AI_MODEL=claude-sonnet-5-5
